{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage",
  "type": "object",
  "properties": {
    "boss": {
      "anyOf": [
        {
          "$ref": "#/$defs/Boss"
        },
        {
          "type": "null"
        }
      ]
    },
    "companions": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Agent"
      }
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "id": {
      "description": "The stage ID: the file name and the first half of the version tag.",
      "type": "string"
    },
    "length_ticks": {
      "description": "Ticks until the stage ends if the boss is still alive.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "player": {
      "$ref": "#/$defs/Player"
    },
    "schema_version": {
      "description": "`crate::version::SCHEMA_VERSION` when the game wrote the file.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "seed": {
      "description": "Seeds the run's SplitMix64 (ADR-033). 32 bits so that every tool reading the file as\nJSON, GDScript included, keeps it exact; the simulation widens it.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "sim_version": {
      "description": "`crate::version::SIM_VERSION` when the game wrote the file.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "title": {
      "type": "string"
    },
    "waves": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Wave"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sim_version",
    "id",
    "title",
    "seed",
    "length_ticks",
    "player"
  ],
  "$defs": {
    "Action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "skill": {
              "$ref": "#/$defs/Skill"
            },
            "type": {
              "type": "string",
              "const": "cast"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "skill"
          ]
        },
        {
          "type": "object",
          "properties": {
            "attack": {
              "$ref": "#/$defs/AttackRef"
            },
            "type": {
              "type": "string",
              "const": "attack"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "attack"
          ]
        },
        {
          "type": "object",
          "properties": {
            "agent": {
              "$ref": "#/$defs/Agent"
            },
            "count": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "summon"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "agent",
            "count"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ticks": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "to": {
              "$ref": "#/$defs/Point"
            },
            "type": {
              "type": "string",
              "const": "move_to"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "to",
            "ticks"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ticks": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "telegraph"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "ticks"
          ]
        }
      ]
    },
    "Agent": {
      "description": "A companion, a regular enemy or (inside a boss phase) the boss: a movement and a rule list.",
      "type": "object",
      "properties": {
        "base": {
          "description": "Asset ID of the sprite (ADR-007).",
          "$ref": "#/$defs/ContentId"
        },
        "defence": {
          "description": "Reduces every hit it takes to `K / (K + defence)` of it (ADR-056); 0 when absent.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "hp": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "movement": {
          "$ref": "#/$defs/Movement"
        },
        "palette": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "radius": {
          "description": "Radius of the hurt circle.",
          "$ref": "#/$defs/Fx"
        },
        "rules": {
          "description": "Evaluated in order each tick; the first rule that can fire, fires (ADR-036).",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Rule"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "base",
        "hp",
        "radius",
        "movement"
      ]
    },
    "AttackPhase": {
      "description": "One phase of an attack (ADR-055).",
      "type": "object",
      "properties": {
        "damage": {
          "description": "Base damage of the phase's hits and of the bullets it spawns (ADR-056). Absent, it is\nwhat the attacker's own attack does: the main character's `atk`, a `shot` skill's\n`damage`, or 1 for an enemy or the boss.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "hit_box": {
          "description": "The area the phase covers, attached to the attacker.",
          "anyOf": [
            {
              "$ref": "#/$defs/HitBox"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/PhaseKind"
        },
        "move_pct": {
          "description": "The attacker's movement speed during the phase, in percent; 0 roots it.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "rehit_ticks": {
          "description": "An active phase only: a target already hit may be hit again after this many ticks.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "spawn": {
          "description": "Emitter nodes started on the phase's first tick, carried out in order (see `rules_v0`'s\nattacks for what each one does).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Emitter"
          }
        },
        "ticks": {
          "description": "How long the phase lasts: a constant, never an expression, so that an attack's length\nand its telegraph are known before it runs.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "ticks"
      ]
    },
    "AttackRef": {
      "description": "A preset by ID with its arguments, or an inline definition.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "preset": {
              "type": "object",
              "properties": {
                "args": {
                  "type": "array",
                  "default": [],
                  "items": {
                    "type": "integer",
                    "format": "int32"
                  }
                },
                "id": {
                  "$ref": "#/$defs/ContentId"
                }
              },
              "additionalProperties": false,
              "required": [
                "id"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "preset"
          ]
        },
        {
          "description": "The phases, in order.",
          "type": "object",
          "properties": {
            "inline": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AttackPhase"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "inline"
          ]
        }
      ]
    },
    "Boss": {
      "description": "Tier 2 (ADR-036): body parts and an ordered list of phases that only move forward.",
      "type": "object",
      "properties": {
        "base": {
          "$ref": "#/$defs/ContentId"
        },
        "defence": {
          "description": "Reduces every hit it takes to `K / (K + defence)` of it (ADR-056); 0 when absent.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "hp": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "palette": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "parts": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/BossPart"
          }
        },
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Phase"
          }
        },
        "radius": {
          "$ref": "#/$defs/Fx"
        },
        "spawn": {
          "$ref": "#/$defs/Point"
        }
      },
      "additionalProperties": false,
      "required": [
        "base",
        "hp",
        "radius",
        "spawn",
        "phases"
      ]
    },
    "BossPart": {
      "description": "A breakable part with its own HP and hurt circle (ADR-007, ADR-036).",
      "type": "object",
      "properties": {
        "asset": {
          "description": "Asset ID of the part's sprite.",
          "$ref": "#/$defs/ContentId"
        },
        "defence": {
          "description": "Reduces every hit it takes to `K / (K + defence)` of it (ADR-056); 0 when absent.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "hp": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "id": {
          "description": "Unique within the boss; `part_broken` and the `part` selector use it.",
          "$ref": "#/$defs/ContentId"
        },
        "offset": {
          "description": "Offset from the boss's centre.",
          "$ref": "#/$defs/Point"
        },
        "radius": {
          "$ref": "#/$defs/Fx"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "asset",
        "hp",
        "offset",
        "radius"
      ]
    },
    "Condition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "always"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pct": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "hp_below"
            },
            "who": {
              "$ref": "#/$defs/Selector"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "who",
            "pct"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "$ref": "#/$defs/ContentId"
            },
            "type": {
              "type": "string",
              "const": "has_status"
            },
            "who": {
              "$ref": "#/$defs/Selector"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "who",
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "aggro_above"
            },
            "value": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "who": {
              "$ref": "#/$defs/Selector"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "who",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "part": {
              "$ref": "#/$defs/ContentId"
            },
            "type": {
              "type": "string",
              "const": "part_broken"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "part"
          ]
        },
        {
          "description": "Ticks since the agent spawned, or since the boss phase began.",
          "type": "object",
          "properties": {
            "ticks": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "time_above"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "ticks"
          ]
        }
      ]
    },
    "ContentId": {
      "description": "A content ID from the registry (ADR-026): asset, palette, part, preset, status or pattern.\nLowercase `snake_case`, at most 32 characters; the validator checks the format and that the\nID exists.",
      "type": "string"
    },
    "Direction": {
      "oneOf": [
        {
          "description": "At the target, turned by `offset`.",
          "type": "object",
          "properties": {
            "offset": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "aimed"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "offset"
          ]
        },
        {
          "description": "A fixed angle: 0 points down the screen, and positive angles turn toward the right.",
          "type": "object",
          "properties": {
            "angle": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "absolute"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "angle"
          ]
        },
        {
          "description": "Turned by `angle` from the parent's direction: straight down for an attack that a rule\nstarted, the direction of the bullet for a `then` list of `on_bullet`.",
          "type": "object",
          "properties": {
            "angle": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "relative"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "angle"
          ]
        },
        {
          "description": "Turned by `step` from the previous bullet's direction; not affected by the turns of\n`rotate`, `ring` and `spread`.",
          "type": "object",
          "properties": {
            "step": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "sequential"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "step"
          ]
        }
      ]
    },
    "Emitter": {
      "oneOf": [
        {
          "description": "One bullet.",
          "type": "object",
          "properties": {
            "bullet": {
              "description": "Bullet asset; absent means the default bullet.",
              "anyOf": [
                {
                  "$ref": "#/$defs/ContentId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "direction": {
              "$ref": "#/$defs/Direction"
            },
            "speed": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "fire"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "speed",
            "direction"
          ]
        },
        {
          "description": "Runs `body` `count` times (at most 100). The next round starts `interval_ticks` ticks\nafter the body of the last one ends.",
          "type": "object",
          "properties": {
            "body": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Emitter"
              }
            },
            "count": {
              "$ref": "#/$defs/Expr"
            },
            "interval_ticks": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "repeat"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "count",
            "interval_ticks",
            "body"
          ]
        },
        {
          "description": "Runs `body` `count` times at once, each round turned a full turn / `count` further than\nthe one before.",
          "type": "object",
          "properties": {
            "body": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Emitter"
              }
            },
            "count": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "ring"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "count",
            "body"
          ]
        },
        {
          "description": "Runs `body` `count` times at once, fanned evenly across `angle` and centred on the\ndirection of the bullets.",
          "type": "object",
          "properties": {
            "angle": {
              "$ref": "#/$defs/Expr"
            },
            "body": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Emitter"
              }
            },
            "count": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "spread"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "count",
            "angle",
            "body"
          ]
        },
        {
          "description": "Turns the direction of everything in `body` by `angle`.",
          "type": "object",
          "properties": {
            "angle": {
              "$ref": "#/$defs/Expr"
            },
            "body": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Emitter"
              }
            },
            "type": {
              "type": "string",
              "const": "rotate"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "angle",
            "body"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ticks": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "wait"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "ticks"
          ]
        },
        {
          "description": "Each bullet fired by `body` starts `then` as an attack of its own, from where the bullet\nis, `after_ticks` ticks later (at the next tick if 0), if it is still flying.",
          "type": "object",
          "properties": {
            "after_ticks": {
              "$ref": "#/$defs/Expr"
            },
            "body": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Emitter"
              }
            },
            "then": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Emitter"
              }
            },
            "type": {
              "type": "string",
              "const": "on_bullet"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "after_ticks",
            "body",
            "then"
          ]
        }
      ]
    },
    "Evade": {
      "description": "A dash with invulnerability (ADR-050). A ready press dashes `distance` over `ticks`, along\nthe movement direction, or along the facing when the stick is centred; the stick is ignored\nuntil the dash ends. Invulnerability and the cooldown count from the press.",
      "type": "object",
      "properties": {
        "cooldown_ticks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "distance": {
          "$ref": "#/$defs/Fx"
        },
        "invulnerable_ticks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "ticks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "distance",
        "ticks",
        "invulnerable_ticks",
        "cooldown_ticks"
      ]
    },
    "Expr": {
      "description": "A fixed-point expression (ADR-036): a literal, an input, or an operator. No variables,\nloops or recursion beyond the tree itself.",
      "anyOf": [
        {
          "description": "The attack's argument at this index.",
          "type": "object",
          "properties": {
            "arg": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "arg"
          ]
        },
        {
          "description": "Index of the innermost `repeat`, `ring` or `spread`.",
          "type": "string",
          "const": "loop_index"
        },
        {
          "description": "Ticks since the attack started: 0 on its first tick.",
          "type": "string",
          "const": "phase_time"
        },
        {
          "description": "A draw from the run's SplitMix64 (ADR-033), from `lo` to `hi` inclusive; `lo` if the\nrange is empty. Expressions are evaluated left to right, so the order of draws is fixed.",
          "type": "object",
          "properties": {
            "rand": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "rand"
          ]
        },
        {
          "type": "object",
          "properties": {
            "add": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "add"
          ]
        },
        {
          "type": "object",
          "properties": {
            "sub": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "sub"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mul": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "mul"
          ]
        },
        {
          "type": "object",
          "properties": {
            "div": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "div"
          ]
        },
        {
          "type": "object",
          "properties": {
