{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StageSkillsFile",
  "description": "The stage skills file.",
  "type": "object",
  "properties": {
    "stage_skills": {
      "description": "The skills, at most `MAX_STAGE_SKILLS`; a skill's place here is what the slot holds.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/StageSkill"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "stage_skills"
  ],
  "$defs": {
    "Anchor": {
      "description": "Where a hit box or a zone is anchored (core Z1).",
      "oneOf": [
        {
          "description": "The attacker's own spot: a hit box follows its attacker, a zone stays where the attacker\nwas when the zone was placed.",
          "type": "string",
          "const": "attacker"
        },
        {
          "description": "The target's spot: where the target stood when the attack began, so that a target that\nleaves during the wind-up leaves the area too.",
          "type": "string",
          "const": "target"
        }
      ]
    },
    "AttackPhase": {
      "description": "One phase of an attack (ADR-055).",
      "type": "object",
      "properties": {
        "breaks_charge": {
          "description": "A powerful attack: its hits on the main character, by hit box or by the zones the phase\nspawns, break a charge in progress (core#83).",
          "type": "boolean"
        },
        "damage": {
          "description": "Base damage of the phase's hits and of the zones it spawns (ADR-056). Absent, it is\nwhat the attacker's own attack does: the main character's `atk`, a `shot` skill's\n`damage`, or 100 (1 at the design values, ADR-103) for an enemy or the boss.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "dash": {
          "description": "An active phase of an enemy's or the boss's attack only: the attacker moves along the\nattack's locked facing over the phase, hit box and boss parts with it (DS11).",
          "anyOf": [
            {
              "$ref": "#/$defs/Dash"
            },
            {
              "type": "null"
            }
          ]
        },
        "hit_box": {
          "description": "The area the phase covers, attached to the attacker.",
          "anyOf": [
            {
              "$ref": "#/$defs/HitBox"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/PhaseKind"
        },
        "move_pct": {
          "description": "The attacker's movement speed during the phase, in percent; 0 roots it.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "rehit_ticks": {
          "description": "An active phase only: a target already hit may be hit again after this many ticks.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "spawn": {
          "description": "Emitter nodes started on the phase's first tick, carried out in order (see `rules_v0`'s\nattacks for what each one does).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Emitter"
          }
        },
        "ticks": {
          "description": "How long the phase lasts: a constant, never an expression, so that an attack's length\nand its telegraph are known before it runs.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "type": {
          "description": "The damage type of the phase's hits and of the zones it spawns (ADR-100); absent, they\nare neutral and never get a match-up.",
          "anyOf": [
            {
              "$ref": "#/$defs/DamageType"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "ticks"
      ]
    },
    "AttackRef": {
      "description": "A preset by ID with its arguments, or an inline definition.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "preset": {
              "type": "object",
              "properties": {
                "args": {
                  "type": "array",
                  "default": [],
                  "items": {
                    "type": "integer",
                    "format": "int32"
                  }
                },
                "id": {
                  "$ref": "#/$defs/ContentId"
                }
              },
              "additionalProperties": false,
              "required": [
                "id"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "preset"
          ]
        },
        {
          "description": "The phases, in order.",
          "type": "object",
          "properties": {
            "inline": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AttackPhase"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "inline"
          ]
        }
      ]
    },
    "ContentId": {
      "description": "A content ID from the registry (ADR-026): asset, palette, part, preset, status or pattern.\nLowercase `snake_case`, at most 32 characters; the validator checks the format and that the\nID exists.",
      "type": "string"
    },
    "DamageType": {
      "description": "The damage types, a closed list (ADR-100): three attack types, which are physical, and the\nelements. A list for the prototype; changing it is a schema change in version 0.",
      "type": "string",
      "enum": [
        "slash",
        "pierce",
        "strike",
        "pyro",
        "hydro",
        "electro",
        "cryo",
        "anemo",
        "geo",
        "dendro"
      ]
    },
    "Dash": {
      "description": "A phase that carries its attacker forward: it covers `distance` over the phase's ticks, held\nto the map. The phase's `move_pct` is 0, so that the walk does not add to it.",
      "type": "object",
      "properties": {
        "distance": {
          "$ref": "#/$defs/Fx"
        }
      },
      "additionalProperties": false,
      "required": [
        "distance"
      ]
    },
    "Direction": {
      "oneOf": [
        {
          "description": "At the target, turned by `offset`.",
          "type": "object",
          "properties": {
            "offset": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "aimed"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "offset"
          ]
        },
        {
          "description": "A fixed angle: 0 points down the screen, and positive angles turn toward the right.",
          "type": "object",
          "properties": {
            "angle": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "absolute"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "angle"
          ]
        },
        {
          "description": "Turned by `angle` from the parent's direction: straight down for an attack that a rule\nstarted, the orb's own direction for the zones of its `burst`.",
          "type": "object",
          "properties": {
            "angle": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "relative"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "angle"
          ]
        },
        {
          "description": "Turned by `step` from the previous orb's or zone's direction; not affected by the turns of\n`rotate`, `ring` and `spread`.",
          "type": "object",
          "properties": {
            "step": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "sequential"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "step"
          ]
        }
      ]
    },
    "Emitter": {
      "oneOf": [
        {
          "description": "Runs `body` `count` times (at most 100). The next round starts `interval_ticks` ticks\nafter the body of the last one ends.",
          "type": "object",
          "properties": {
            "body": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Emitter"
              }
            },
            "count": {
              "$ref": "#/$defs/Expr"
            },
            "interval_ticks": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "repeat"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "count",
            "interval_ticks",
            "body"
          ]
        },
        {
          "description": "Runs `body` `count` times at once, each round turned a full turn / `count` further than\nthe one before.",
          "type": "object",
          "properties": {
            "body": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Emitter"
              }
            },
            "count": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "ring"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "count",
            "body"
          ]
        },
        {
          "description": "Runs `body` `count` times at once, fanned evenly across `angle` and centred on the\ndirection of the attack.",
          "type": "object",
          "properties": {
            "angle": {
              "$ref": "#/$defs/Expr"
            },
            "body": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Emitter"
              }
            },
            "count": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "spread"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "count",
            "angle",
            "body"
          ]
        },
        {
          "description": "Turns the direction of everything in `body` by `angle`.",
          "type": "object",
          "properties": {
            "angle": {
              "$ref": "#/$defs/Expr"
            },
            "body": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Emitter"
              }
            },
            "type": {
              "type": "string",
              "const": "rotate"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "angle",
            "body"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ticks": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "wait"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "ticks"
          ]
        },
        {
          "description": "A slow projectile with a required lifetime (core Z2, DS10): it flies for `ticks` ticks\n(1 to `limits::MAX_ORB_TICKS`), and then `burst` runs from where it ended, as an attack of\nits own. A `breakable` orb is destroyed, with no burst, by the main character's hit boxes.\nEnemy attacks only; the burst holds only `zone`, `ring`, `spread`, `repeat`, `rotate` and\n`wait` nodes. At most `MAX_ORBS_PER_OWNER` orbs per attacker and `MAX_ORBS_ALIVE` in all;\none over a cap is dropped.",
          "type": "object",
          "properties": {
            "anchor": {
              "description": "Where the orbs spawn from: the attacker, or the target as it is when the node fires\n(Z3a-4). Sampled once; the orbs then fly on their own.",
              "$ref": "#/$defs/Anchor"
            },
            "breakable": {
              "type": "boolean"
            },
            "burst": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Emitter"
              }
            },
            "direction": {
              "$ref": "#/$defs/Direction"
            },
            "link": {
              "description": "Joins this orb to its neighbours in the ring it is fired in, once they are not flying\ntoward a halt: the beams hurt the main character. Needs an enclosing `ring`, `spread` or\n`repeat` of at least 2 rounds.",
              "anyOf": [
                {
                  "$ref": "#/$defs/Link"
                },
                {
                  "type": "null"
                }
              ]
            },
            "offset": {
              "description": "Moves the spawn point forward along the orb's direction and to the right of it.",
              "$ref": "#/$defs/Offset"
            },
            "speed": {
              "$ref": "#/$defs/Expr"
            },
            "stop_after": {
              "description": "Ticks after it is fired when the orb halts (0 to `ticks`): it stays where it is, and its\nlifetime runs on. It moves on the tick it is fired, so it moves `stop_after` times.",
              "anyOf": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "type": "null"
                }
              ]
            },
            "style": {
              "description": "Orb asset; absent means the default orb.",
              "anyOf": [
                {
                  "$ref": "#/$defs/ContentId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "ticks": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "orb"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "speed",
            "direction",
            "ticks"
          ]
        },
        {
          "description": "A zone that does not move (core Z1): it is placed at the `anchor`, moved by `offset`\n(forward along its `direction`, and to the right of it), warns for `wind_up_ticks`,\nhurts each target at most once for `active_ticks`, then ends. `ring`, `spread` and\n`rotate` turn its direction, and with it the offset, as they turn an orb's.",
          "type": "object",
          "properties": {
            "active_ticks": {
              "description": "1 to `MAX_ZONE_TICKS`. Required, unless the zone is `warn_only`, which refuses it.",
              "anyOf": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "type": "null"
                }
              ]
            },
            "anchor": {
              "$ref": "#/$defs/Anchor"
            },
            "direction": {
              "$ref": "#/$defs/Direction",
              "default": {
                "offset": 0,
                "type": "aimed"
              }
            },
            "offset": {
              "$ref": "#/$defs/Offset",
              "default": {
                "forward": 0,
                "right": 0
              }
            },
            "shape": {
              "$ref": "#/$defs/ZoneShape"
            },
            "type": {
              "type": "string",
              "const": "zone"
            },
            "warn_only": {
              "description": "A warning only (Z3a-4): it warns for `wind_up_ticks` (1 or more) and then ends. It\nnever becomes active, never hurts and gives no invulnerability; its phase's `damage`,\n`type` and `breaks_charge` are not used for it. It counts in `MAX_ZONES_ALIVE`.",
              "type": "boolean"
            },
            "wind_up_ticks": {
              "description": "0 to `MAX_ZONE_TICKS`; 0 is a zone that hurts at once.",
              "$ref": "#/$defs/Expr"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "shape",
            "wind_up_ticks"
          ]
        }
      ]
    },
    "Expr": {
      "description": "A fixed-point expression (ADR-036): a literal, an input, or an operator. No variables,\nloops or recursion beyond the tree itself.",
      "anyOf": [
        {
          "description": "The attack's argument at this index.",
          "type": "object",
          "properties": {
            "arg": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "arg"
          ]
        },
        {
          "description": "Index of the innermost `repeat`, `ring` or `spread`.",
          "type": "string",
          "const": "loop_index"
        },
        {
          "description": "Ticks since the attack started: 0 on its first tick.",
          "type": "string",
          "const": "phase_time"
        },
        {
          "description": "A draw from the run's SplitMix64 (ADR-033), from `lo` to `hi` inclusive; `lo` if the\nrange is empty. Expressions are evaluated left to right, so the order of draws is fixed.",
          "type": "object",
          "properties": {
            "rand": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "rand"
          ]
        },
        {
          "type": "object",
          "properties": {
            "add": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "add"
          ]
        },
        {
          "type": "object",
          "properties": {
            "sub": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "sub"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mul": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "mul"
          ]
        },
        {
          "type": "object",
          "properties": {
            "div": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "div"
          ]
        },
        {
          "type": "object",
          "properties": {
            "min": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "min"
          ]
        },
        {
          "type": "object",
          "properties": {
            "max": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "max"
          ]
        },
        {
          "description": "`[value, lo, hi]`.",
          "type": "object",
          "properties": {
            "clamp": {
              "type": "array",
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "clamp"
          ]
        },
        {
          "description": "A literal; written as a plain integer.",
          "type": "integer",
          "format": "int32"
        }
      ]
    },
    "Fx": {
      "description": "A length in 1/256 pixel units. In files it is the plain integer.",
      "type": "integer",
      "format": "int32"
    },
    "HitBox": {
      "description": "A hit box, in the attacker's own frame: `offset` is forward along the attacker's facing\nand to its right, from the `anchor`.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "anchor": {
              "$ref": "#/$defs/Anchor"
            },
            "offset": {
              "$ref": "#/$defs/Offset",
              "default": {
                "forward": 0,
                "right": 0
              }
            },
            "radius": {
              "$ref": "#/$defs/Fx"
            },
            "type": {
              "type": "string",
              "const": "circle"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "radius"
          ]
        },
        {
          "description": "A circle sector centred on the facing, `half_angle` to each side.",
          "type": "object",
          "properties": {
            "anchor": {
              "$ref": "#/$defs/Anchor"
            },
            "half_angle": {
              "type": "integer",
              "format": "int32"
            },
            "offset": {
              "$ref": "#/$defs/Offset",
              "default": {
                "forward": 0,
                "right": 0
              }
            },
            "radius": {
              "$ref": "#/$defs/Fx"
            },
            "type": {
              "type": "string",
              "const": "arc"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "radius",
            "half_angle"
          ]
        },
        {
          "description": "A rectangle from its starting point (the anchor and `offset`) along the facing turned by\n`angle`: `length` long and `width` wide, half of it to each side.",
          "type": "object",
          "properties": {
            "anchor": {
              "$ref": "#/$defs/Anchor"
            },
            "angle": {
              "description": "Turn from the facing, in 1/256 degree; positive turns toward the right.",
              "type": "integer",
              "format": "int32",
              "default": 0
            },
            "length": {
              "$ref": "#/$defs/Fx"
            },
            "offset": {
              "$ref": "#/$defs/Offset",
              "default": {
                "forward": 0,
                "right": 0
              }
            },
            "type": {
              "type": "string",
              "const": "line"
            },
            "width": {
              "$ref": "#/$defs/Fx"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "length",
            "width"
          ]
        }
      ]
    },
    "Link": {
      "description": "The beams between the orbs of one ring (Z3a-3): between slot `j` and slot `j + 1` of the orbs\none `ring`, `spread` or `repeat` fires (the last to the first, unless there are only two), while\nboth are on the map. A beam is a rectangle `width` across that hurts the main character, each\nbeam at most once per `rehit_ticks`.",
      "type": "object",
      "properties": {
        "damage": {
          "description": "The damage of a beam hit; absent means the orb's own.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "rehit_ticks": {
          "description": "1 to 600.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "width": {
          "description": "1 to 64 pixels.",
          "$ref": "#/$defs/Fx"
        }
      },
      "additionalProperties": false,
      "required": [
        "width",
        "rehit_ticks"
      ]
    },
    "Offset": {
      "type": "object",
      "properties": {
        "forward": {
          "$ref": "#/$defs/Fx",
          "default": 0
        },
        "right": {
          "$ref": "#/$defs/Fx",
          "default": 0
        }
      },
      "additionalProperties": false
    },
    "PhaseKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "recovery"
          ]
        },
        {
          "description": "The telegraph: its hit box is the warned area, and it deals no damage.",
          "type": "string",
          "const": "wind_up"
        },
        {
