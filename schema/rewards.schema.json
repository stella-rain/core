{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RewardsFile",
  "description": "The rewards file.",
  "type": "object",
  "properties": {
    "max_rune_haste_pct": {
      "description": "The most Rune Haste the picks add up to, in percent, 1 to `MAX_RUNE_HASTE_PCT`\n(app#298); absent, `DEFAULT_MAX_RUNE_HASTE_PCT`. A reward gives at most this.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "rewards": {
      "description": "The rewards, in the order offers draw them from.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Reward"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "sim_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sim_version",
    "rewards"
  ],
  "$defs": {
    "AttackPhase": {
      "description": "One phase of an attack (ADR-055).",
      "type": "object",
      "properties": {
        "breaks_charge": {
          "description": "A powerful attack: its hits on the main character, by hit box or by the bullets the phase\nspawns, break a charge in progress (core#83).",
          "type": "boolean"
        },
        "damage": {
          "description": "Base damage of the phase's hits and of the bullets it spawns (ADR-056). Absent, it is\nwhat the attacker's own attack does: the main character's `atk`, a `shot` skill's\n`damage`, or 100 (1 at the design values, ADR-103) for an enemy or the boss.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "hit_box": {
          "description": "The area the phase covers, attached to the attacker.",
          "anyOf": [
            {
              "$ref": "#/$defs/HitBox"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/PhaseKind"
        },
        "move_pct": {
          "description": "The attacker's movement speed during the phase, in percent; 0 roots it.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "rehit_ticks": {
          "description": "An active phase only: a target already hit may be hit again after this many ticks.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "spawn": {
          "description": "Emitter nodes started on the phase's first tick, carried out in order (see `rules_v0`'s\nattacks for what each one does).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Emitter"
          }
        },
        "ticks": {
          "description": "How long the phase lasts: a constant, never an expression, so that an attack's length\nand its telegraph are known before it runs.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "type": {
          "description": "The damage type of the phase's hits and of the bullets it spawns (ADR-100); absent, they\nare neutral and never get a match-up.",
          "anyOf": [
            {
              "$ref": "#/$defs/DamageType"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "ticks"
      ]
    },
    "AttackRef": {
      "description": "A preset by ID with its arguments, or an inline definition.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "preset": {
              "type": "object",
              "properties": {
                "args": {
                  "type": "array",
                  "default": [],
                  "items": {
                    "type": "integer",
                    "format": "int32"
                  }
                },
                "id": {
                  "$ref": "#/$defs/ContentId"
                }
              },
              "additionalProperties": false,
              "required": [
                "id"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "preset"
          ]
        },
        {
          "description": "The phases, in order.",
          "type": "object",
          "properties": {
            "inline": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AttackPhase"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "inline"
          ]
        }
      ]
    },
    "ContentId": {
      "description": "A content ID from the registry (ADR-026): asset, palette, part, preset, status or pattern.\nLowercase `snake_case`, at most 32 characters; the validator checks the format and that the\nID exists.",
      "type": "string"
    },
    "DamageType": {
      "description": "The damage types, a closed list (ADR-100): three attack types, which are physical, and the\nelements. A list for the prototype; changing it is a schema change in version 0.",
      "type": "string",
      "enum": [
        "slash",
        "pierce",
        "strike",
        "pyro",
        "hydro",
        "electro",
        "cryo",
        "anemo",
        "geo",
        "dendro"
      ]
    },
    "Direction": {
      "oneOf": [
        {
          "description": "At the target, turned by `offset`.",
          "type": "object",
          "properties": {
            "offset": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "aimed"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "offset"
          ]
        },
        {
          "description": "A fixed angle: 0 points down the screen, and positive angles turn toward the right.",
          "type": "object",
          "properties": {
            "angle": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "absolute"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "angle"
          ]
        },
        {
          "description": "Turned by `angle` from the parent's direction: straight down for an attack that a rule\nstarted, the direction of the bullet for a `then` list of `on_bullet`.",
          "type": "object",
          "properties": {
            "angle": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "relative"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "angle"
          ]
        },
        {
          "description": "Turned by `step` from the previous bullet's direction; not affected by the turns of\n`rotate`, `ring` and `spread`.",
          "type": "object",
          "properties": {
            "step": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "sequential"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "step"
          ]
        }
      ]
    },
    "EffectEntry": {
      "description": "One effect of a reward: an effect kind with the fields that kind takes.",
      "type": "object",
      "properties": {
        "amount": {
          "description": "What taking it adds to the effect's total, from 1 to `MAX_AMOUNT`; for a stage skill,\nthe levels it gives, from 1 to `MAX_SKILL_LEVELS`; for evade charges, the charges it\nadds, from 1 to `MAX_EVADE_CHARGES`; for an orbit, the orbs it adds, from 1 to\n`MAX_ORBS`; for range, how much wider, from 1 to `MAX_RANGE_PCT` percent; for Rune\nHaste, the percent of haste, from 1 to the file's `max_rune_haste_pct`; for a type bonus, the\npercent, from 1 to `MAX_AMOUNT`. Required by every effect but the random rune, which\nhas none.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "depth": {
          "description": "The links of a chain of bursts, from 1 to `MAX_BURST_DEPTH`: with the `kill_burst`\neffect only, and required by it.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "effect": {
          "$ref": "#/$defs/RewardEffect"
        },
        "kills": {
          "description": "The kills between two heals, from 1 to `MAX_HEAL_KILLS`: with the `heal_per_kills`\neffect only, and required by it.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "orbit": {
          "description": "The orbit it gives: with the `orbit` effect only, and required by it.",
          "anyOf": [
            {
              "$ref": "#/$defs/Orbit"
            },
            {
              "type": "null"
            }
          ]
        },
        "radius": {
          "description": "How far a burst reaches, in pixels, from 1 to `MAX_BURST_RADIUS_PX`: with the\n`kill_burst` effect only, and required by it. Its `amount` is the percent of hit points.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "skill": {
          "description": "The stage skill it gives, one of the stage skills file's: with the `stage_skill` effect\nonly, and required by it.",
          "anyOf": [
            {
              "$ref": "#/$defs/ContentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "description": "The damage type its bonus raises: with the `type_bonus_pct` effect only, and required\nby it.",
          "anyOf": [
            {
              "$ref": "#/$defs/DamageType"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "effect"
      ]
    },
    "Emitter": {
      "oneOf": [
        {
          "description": "One bullet.",
          "type": "object",
          "properties": {
            "bullet": {
              "description": "Bullet asset; absent means the default bullet.",
              "anyOf": [
                {
                  "$ref": "#/$defs/ContentId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "direction": {
              "$ref": "#/$defs/Direction"
            },
            "speed": {
              "$ref": "#/$defs/Expr"
            },
            "ticks": {
              "description": "How many ticks the bullet lives, at least 1 and at most `limits::MAX_BULLET_TICKS`;\nabsent means it lives until it is past the map's margin (core#147).",
              "anyOf": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "fire"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "speed",
            "direction"
          ]
        },
        {
          "description": "Runs `body` `count` times (at most 100). The next round starts `interval_ticks` ticks\nafter the body of the last one ends.",
          "type": "object",
          "properties": {
            "body": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Emitter"
              }
            },
            "count": {
              "$ref": "#/$defs/Expr"
            },
            "interval_ticks": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "repeat"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "count",
            "interval_ticks",
            "body"
          ]
        },
        {
          "description": "Runs `body` `count` times at once, each round turned a full turn / `count` further than\nthe one before.",
          "type": "object",
          "properties": {
            "body": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Emitter"
              }
            },
            "count": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "ring"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "count",
            "body"
          ]
        },
        {
          "description": "Runs `body` `count` times at once, fanned evenly across `angle` and centred on the\ndirection of the bullets.",
          "type": "object",
          "properties": {
            "angle": {
              "$ref": "#/$defs/Expr"
            },
            "body": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Emitter"
              }
            },
            "count": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "spread"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "count",
            "angle",
            "body"
          ]
        },
        {
          "description": "Turns the direction of everything in `body` by `angle`.",
          "type": "object",
          "properties": {
            "angle": {
              "$ref": "#/$defs/Expr"
            },
            "body": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Emitter"
              }
            },
            "type": {
              "type": "string",
              "const": "rotate"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "angle",
            "body"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ticks": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "wait"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "ticks"
          ]
        },
        {
          "description": "Each bullet fired by `body` starts `then` as an attack of its own, from where the bullet\nis, `after_ticks` ticks later (at the next tick if 0), if it is still flying.",
          "type": "object",
          "properties": {
            "after_ticks": {
              "$ref": "#/$defs/Expr"
            },
            "body": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Emitter"
              }
            },
            "then": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Emitter"
              }
            },
            "type": {
              "type": "string",
              "const": "on_bullet"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "after_ticks",
            "body",
            "then"
          ]
        }
      ]
    },
    "Expr": {
      "description": "A fixed-point expression (ADR-036): a literal, an input, or an operator. No variables,\nloops or recursion beyond the tree itself.",
      "anyOf": [
        {
          "description": "The attack's argument at this index.",
          "type": "object",
          "properties": {
            "arg": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "arg"
          ]
        },
        {
          "description": "Index of the innermost `repeat`, `ring` or `spread`.",
          "type": "string",
          "const": "loop_index"
        },
        {
          "description": "Ticks since the attack started: 0 on its first tick.",
          "type": "string",
          "const": "phase_time"
        },
        {
          "description": "A draw from the run's SplitMix64 (ADR-033), from `lo` to `hi` inclusive; `lo` if the\nrange is empty. Expressions are evaluated left to right, so the order of draws is fixed.",
          "type": "object",
          "properties": {
            "rand": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "rand"
          ]
        },
        {
          "type": "object",
          "properties": {
            "add": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "add"
          ]
        },
        {
          "type": "object",
          "properties": {
            "sub": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "sub"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mul": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "mul"
          ]
        },
        {
          "type": "object",
          "properties": {
            "div": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "div"
          ]
        },
        {
          "type": "object",
          "properties": {
            "min": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "min"
          ]
        },
        {
          "type": "object",
          "properties": {
            "max": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "max"
          ]
        },
        {
          "description": "`[value, lo, hi]`.",
          "type": "object",
          "properties": {
            "clamp": {
              "type": "array",
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "clamp"
          ]
        },
        {
          "description": "A literal; written as a plain integer.",
          "type": "integer",
          "format": "int32"
        }
      ]
    },
    "Fx": {
      "description": "A length in 1/256 pixel units. In files it is the plain integer.",
      "type": "integer",
      "format": "int32"
    },
    "HitBox": {
      "description": "A hit box, in the attacker's own frame: `offset` is forward along the attacker's facing\nand to its right.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "offset": {
              "$ref": "#/$defs/Offset",
              "default": {
                "forward": 0,
                "right": 0
              }
            },
            "radius": {
              "$ref": "#/$defs/Fx"
            },
            "type": {
              "type": "string",
              "const": "circle"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "radius"
          ]
        },
        {
          "description": "A circle sector centred on the facing, `half_angle` to each side.",
          "type": "object",
          "properties": {
            "half_angle": {
              "type": "integer",
              "format": "int32"
            },
            "offset": {
              "$ref": "#/$defs/Offset",
              "default": {
                "forward": 0,
                "right": 0
              }
            },
            "radius": {
              "$ref": "#/$defs/Fx"
            },
            "type": {
              "type": "string",
              "const": "arc"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "radius",
            "half_angle"
          ]
        }
      ]
    },
    "Offset": {
      "type": "object",
      "properties": {
        "forward": {
          "$ref": "#/$defs/Fx",
          "default": 0
        },
        "right": {
          "$ref": "#/$defs/Fx",
          "default": 0
        }
      },
      "additionalProperties": false
    },
    "Orbit": {
      "description": "Orbs that turn round the main character and attack on their own (ADR-069). Each orb runs\n`attack` in an attack slot of its own, at the main character's attack stat, its facing\nturned `turn_per_tick` further every tick and the orbs spaced evenly round the turn: the\nattack's hit box offset is how far out an orb is. A round of attacks starts when the orbit\narrives and again `cooldown_ticks` after a round's start, once the round before has ended.",
      "type": "object",
      "properties": {
        "attack": {
          "description": "The attack each orb runs, validated as any attack is.",
          "$ref": "#/$defs/AttackRef"
        },
        "cooldown_ticks": {
          "description": "Ticks from a round's start to the next one's, from 1 to `MAX_ORBIT_COOLDOWN_TICKS`.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "turn_per_tick": {
          "description": "How far the orbs turn a tick, in 1/256 degree, toward the right for positive angles,\nat most `MAX_ORBIT_TURN` either way.",
          "type": "integer",
          "format": "int32"
        }
      },
      "additionalProperties": false,
      "required": [
        "attack",
        "turn_per_tick",
        "cooldown_ticks"
      ]
    },
    "PhaseKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "recovery"
          ]
        },
        {
          "description": "The telegraph: its hit box is the warned area, and it deals no damage.",
          "type": "string",
          "const": "wind_up"
        },
        {
          "description": "Its hit box deals damage.",
          "type": "string",
          "const": "active"
        }
      ]
    },
    "Rarity": {
      "description": "A reward's rarity, from the most common up (ADR-079 §2).",
      "type": "string",
      "enum": [
        "common",
        "uncommon",
        "rare",
        "epic",
        "legendary",
        "supernova"
      ]
    },
    "Reward": {
      "description": "One reward an offer can hold. In a file it is written with an `effects` list of 1 to\n`MAX_REWARD_EFFECTS` entries, or in the released form, with one effect's fields on the\nreward itself, which reads as a list of one (ADR-026).",
      "type": "object",
      "properties": {
        "amount": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        },
        "depth": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        },
        "description": {
          "type": "string"
        },
        "effect": {
          "description": "The released form's single effect: with its `skill`, `orbit`, `type` and `amount`.",
          "anyOf": [
            {
              "$ref": "#/$defs/RewardEffect"
            },
            {
