{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunVerified",
  "description": "What a successful verification proves: the run as recorded reaches this tick and hash.",
  "type": "object",
  "properties": {
    "commands": {
      "description": "The commands between ticks that applied.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "final_hash": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "ledger": {
      "description": "The ledger of counts, bestiary encounters and build picks (ADR-BRDG-6).",
      "$ref": "#/$defs/RunLedger"
    },
    "outcome": {
      "description": "How the run stood at the end: a bug report may stop while it is still running.",
      "$ref": "#/$defs/Outcome"
    },
    "stardust": {
      "description": "The Stardust the run earned, times 10, at most `limits::MAX_RUN_STARDUST` (ADR-109): the\napp pays it after the run (ADR-079, ADR-101).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "ticks": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "ticks",
    "final_hash",
    "outcome",
    "commands",
    "stardust",
    "ledger"
  ],
  "$defs": {
    "ContentId": {
      "description": "A content ID from the registry (ADR-026): asset, palette, part, preset, status or pattern.\nLowercase `snake_case`, at most 32 characters; the validator checks the format and that the\nID exists.",
      "type": "string"
    },
    "Outcome": {
      "description": "How a run stands.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "running"
          ]
        },
        {
          "description": "The stage was cleared: this is what a replay has to prove (ADR-009).",
          "type": "string",
          "const": "cleared"
        },
        {
          "description": "The main character died, or the stage ran out of ticks.",
          "type": "string",
          "const": "failed"
        }
      ]
    },
    "Rarity": {
      "description": "A reward's rarity, from the most common up (ADR-079 §2).",
      "type": "string",
      "enum": [
        "common",
        "uncommon",
        "rare",
        "epic",
        "legendary",
        "supernova"
      ]
    },
    "RunLedger": {
      "description": "A run's ledger of counts and bestiary encounters, verified with the replay (ADR-BRDG-6).",
      "type": "object",
      "properties": {
        "bestiary": {
          "description": "Bestiary bits per enemy kind ID: bit 0 encountered, bits 1..=10 for `DamageType::ALL`.",
          "type": "array",
          "items": {
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "$ref": "#/$defs/ContentId"
              },
              {
                "type": "integer",
                "format": "uint16",
                "maximum": 65535,
                "minimum": 0
              }
            ]
          }
        },
        "kills": {
          "description": "Kill statistics: `kills.<weapon>.<class>` and `slain.<kind_id>`.",
          "type": "array",
          "items": {
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              }
            ]
          }
        },
        "picks": {
          "description": "The stars the main character took, in pick order: the run's build.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/StarPick"
          }
        },
        "skill_uses": {
          "description": "Stage skill uses per stage skill ID.",
          "type": "array",
          "items": {
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "$ref": "#/$defs/ContentId"
              },
              {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              }
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "kills",
        "bestiary",
        "picks",
        "skill_uses"
      ]
    },
    "StarPick": {
      "description": "A star in the run's build (core#NS3).",
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "rarity": {
          "$ref": "#/$defs/Rarity"
        }
      },
      "additionalProperties": false,
      "required": [
        "rarity"
      ]
    }
  }
}
