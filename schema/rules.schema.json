{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RulesFile",
  "description": "The rules file.",
  "type": "object",
  "properties": {
    "cap_headroom_pct": {
      "description": "How far above the target the cap stands, in percent, from 25 to 30.",
      "type": "integer",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0
    },
    "crowd_target": {
      "description": "The enemies a horde run keeps alive: wave spawns that fall due at it are held. From 1 to\nthe most that keeps the cap within the engine ceiling (384 at a headroom of 30).",
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "sim_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sim_version",
    "crowd_target",
    "cap_headroom_pct"
  ]
}
