{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WeaponsFile",
  "description": "The weapons file.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "sim_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "weapons": {
      "description": "The weapons, 1 to `MAX_WEAPONS`.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/WeaponEntry"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sim_version",
    "weapons"
  ],
  "$defs": {
    "Anchor": {
      "description": "Where a hit box or a zone is anchored (core Z1).",
      "oneOf": [
        {
          "description": "The attacker's own spot: a hit box follows its attacker, a zone stays where the attacker\nwas when the zone was placed.",
          "type": "string",
          "const": "attacker"
        },
        {
          "description": "The target's spot: where the target stood when the attack began, so that a target that\nleaves during the wind-up leaves the area too.",
          "type": "string",
          "const": "target"
        }
      ]
    },
    "AttackPhase": {
      "description": "One phase of an attack (ADR-055).",
      "type": "object",
      "properties": {
        "breaks_charge": {
          "description": "A powerful attack: its hits on the main character, by hit box or by the bullets the phase\nspawns, break a charge in progress (core#83).",
          "type": "boolean"
        },
        "damage": {
          "description": "Base damage of the phase's hits and of the bullets it spawns (ADR-056). Absent, it is\nwhat the attacker's own attack does: the main character's `atk`, a `shot` skill's\n`damage`, or 100 (1 at the design values, ADR-103) for an enemy or the boss.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "hit_box": {
          "description": "The area the phase covers, attached to the attacker.",
          "anyOf": [
            {
              "$ref": "#/$defs/HitBox"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/PhaseKind"
        },
        "move_pct": {
          "description": "The attacker's movement speed during the phase, in percent; 0 roots it.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "rehit_ticks": {
          "description": "An active phase only: a target already hit may be hit again after this many ticks.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "spawn": {
          "description": "Emitter nodes started on the phase's first tick, carried out in order (see `rules_v0`'s\nattacks for what each one does).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Emitter"
          }
        },
        "ticks": {
          "description": "How long the phase lasts: a constant, never an expression, so that an attack's length\nand its telegraph are known before it runs.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "type": {
          "description": "The damage type of the phase's hits and of the bullets it spawns (ADR-100); absent, they\nare neutral and never get a match-up.",
          "anyOf": [
            {
              "$ref": "#/$defs/DamageType"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "ticks"
      ]
    },
    "AttackRef": {
      "description": "A preset by ID with its arguments, or an inline definition.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "preset": {
              "type": "object",
              "properties": {
                "args": {
                  "type": "array",
                  "default": [],
                  "items": {
                    "type": "integer",
                    "format": "int32"
                  }
                },
                "id": {
                  "$ref": "#/$defs/ContentId"
                }
              },
              "additionalProperties": false,
              "required": [
                "id"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "preset"
          ]
        },
        {
          "description": "The phases, in order.",
          "type": "object",
          "properties": {
            "inline": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AttackPhase"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "inline"
          ]
        }
      ]
    },
    "Branches": {
      "description": "The steps that follow: at most one for a press of each button.",
      "type": "object",
      "properties": {
        "main": {
          "description": "The step a press of `main` (A) takes.",
          "anyOf": [
            {
              "$ref": "#/$defs/Step"
            },
            {
              "type": "null"
            }
          ]
        },
        "smash": {
          "description": "The step a press of `smash` (B) takes: a smash, which the weapon's smash effect joins.",
          "anyOf": [
            {
              "$ref": "#/$defs/Step"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Charge": {
      "description": "A charged step (ADR-070): the ticks held raise its level, and letting go attacks at the\nlevel reached; inside the level's perfect window it adds its perfect bonus. At `max_ticks`\nit releases by itself, without the bonus. Level 0, before the first of `levels`, is the\nstep's own attack. The frontend slows time from level 1; the rules do not.",
      "type": "object",
      "properties": {
        "levels": {
          "description": "Level 1 and up, in order of `at_ticks`, the first after 0.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChargeLevel"
          }
        },
        "max_ticks": {
          "description": "The longest hold, in ticks.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "move_pct": {
          "description": "The main character's movement speed while charging, in percent; 100 when absent.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "levels",
        "max_ticks"
      ]
    },
    "ChargeLevel": {
      "description": "One level of a charge, from level 1.",
      "type": "object",
      "properties": {
        "at_ticks": {
          "description": "Ticks held at which the level is reached.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "attack": {
          "description": "The release at this level.",
          "$ref": "#/$defs/AttackRef"
        },
        "perfect_attack": {
          "description": "A perfect release makes this attack instead, with `perfect_pct` too.",
          "anyOf": [
            {
              "$ref": "#/$defs/AttackRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "perfect_pct": {
          "description": "The perfect bonus: this much more damage, in percent, for every hit of the release.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "perfect_ticks": {
          "description": "The perfect window: the first `perfect_ticks` ticks of the level; 0 for none.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "at_ticks",
        "attack"
      ]
    },
    "ContentId": {
      "description": "A content ID from the registry (ADR-026): asset, palette, part, preset, status or pattern.\nLowercase `snake_case`, at most 32 characters; the validator checks the format and that the\nID exists.",
      "type": "string"
    },
    "DamageType": {
      "description": "The damage types, a closed list (ADR-100): three attack types, which are physical, and the\nelements. A list for the prototype; changing it is a schema change in version 0.",
      "type": "string",
      "enum": [
        "slash",
        "pierce",
        "strike",
        "pyro",
        "hydro",
        "electro",
        "cryo",
        "anemo",
        "geo",
        "dendro"
      ]
    },
    "Direction": {
      "oneOf": [
        {
          "description": "At the target, turned by `offset`.",
          "type": "object",
          "properties": {
            "offset": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "aimed"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "offset"
          ]
        },
        {
          "description": "A fixed angle: 0 points down the screen, and positive angles turn toward the right.",
          "type": "object",
          "properties": {
            "angle": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "absolute"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "angle"
          ]
        },
        {
          "description": "Turned by `angle` from the parent's direction: straight down for an attack that a rule\nstarted, the direction of the bullet for a `then` list of `on_bullet`.",
          "type": "object",
          "properties": {
            "angle": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "relative"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "angle"
          ]
        },
        {
          "description": "Turned by `step` from the previous bullet's direction; not affected by the turns of\n`rotate`, `ring` and `spread`.",
          "type": "object",
          "properties": {
            "step": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "sequential"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "step"
          ]
        }
      ]
    },
    "Emitter": {
      "oneOf": [
        {
          "description": "One bullet.",
          "type": "object",
          "properties": {
            "bullet": {
              "description": "Bullet asset; absent means the default bullet.",
              "anyOf": [
                {
                  "$ref": "#/$defs/ContentId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "direction": {
              "$ref": "#/$defs/Direction"
            },
            "speed": {
              "$ref": "#/$defs/Expr"
            },
            "ticks": {
              "description": "How many ticks the bullet lives, at least 1 and at most `limits::MAX_BULLET_TICKS`;\nabsent means it lives until it is past the map's margin (core#147).",
              "anyOf": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "fire"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "speed",
            "direction"
          ]
        },
        {
          "description": "Runs `body` `count` times (at most 100). The next round starts `interval_ticks` ticks\nafter the body of the last one ends.",
          "type": "object",
          "properties": {
            "body": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Emitter"
              }
            },
            "count": {
              "$ref": "#/$defs/Expr"
            },
            "interval_ticks": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "repeat"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "count",
            "interval_ticks",
            "body"
          ]
        },
        {
          "description": "Runs `body` `count` times at once, each round turned a full turn / `count` further than\nthe one before.",
          "type": "object",
          "properties": {
            "body": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Emitter"
              }
            },
            "count": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "ring"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "count",
            "body"
          ]
        },
        {
          "description": "Runs `body` `count` times at once, fanned evenly across `angle` and centred on the\ndirection of the bullets.",
          "type": "object",
          "properties": {
            "angle": {
              "$ref": "#/$defs/Expr"
            },
            "body": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Emitter"
              }
            },
            "count": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "spread"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "count",
            "angle",
            "body"
          ]
        },
        {
          "description": "Turns the direction of everything in `body` by `angle`.",
          "type": "object",
          "properties": {
            "angle": {
              "$ref": "#/$defs/Expr"
            },
            "body": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Emitter"
              }
            },
            "type": {
              "type": "string",
              "const": "rotate"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "angle",
            "body"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ticks": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "wait"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "ticks"
          ]
        },
        {
          "description": "Each bullet fired by `body` starts `then` as an attack of its own, from where the bullet\nis, `after_ticks` ticks later (at the next tick if 0), if it is still flying.",
          "type": "object",
          "properties": {
            "after_ticks": {
              "$ref": "#/$defs/Expr"
            },
            "body": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Emitter"
              }
            },
            "then": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Emitter"
              }
            },
            "type": {
              "type": "string",
              "const": "on_bullet"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "after_ticks",
            "body",
            "then"
          ]
        },
        {
          "description": "A slow projectile with a required lifetime (core Z2, DS10): it flies for `ticks` ticks\n(1 to `limits::MAX_ORB_TICKS`), and then `burst` runs from where it ended, as an attack of\nits own. A `breakable` orb is destroyed, with no burst, by the main character's hit boxes.\nEnemy attacks only; the burst holds only `zone`, `ring`, `spread`, `repeat`, `rotate` and\n`wait` nodes. At most `MAX_ORBS_PER_OWNER` orbs per attacker and `MAX_ORBS_ALIVE` in all;\none over a cap is dropped.",
          "type": "object",
          "properties": {
            "breakable": {
              "type": "boolean"
            },
            "burst": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Emitter"
              }
            },
            "direction": {
              "$ref": "#/$defs/Direction"
            },
            "speed": {
              "$ref": "#/$defs/Expr"
            },
            "style": {
              "description": "Bullet asset; absent means the default bullet.",
              "anyOf": [
                {
                  "$ref": "#/$defs/ContentId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "ticks": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "orb"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "speed",
            "direction",
            "ticks"
          ]
        },
        {
          "description": "A zone that does not move (core Z1): it is placed at the `anchor`, moved by `offset`\n(forward along its `direction`, and to the right of it), warns for `wind_up_ticks`,\nhurts each target at most once for `active_ticks`, then ends. `ring`, `spread` and\n`rotate` turn its direction, and with it the offset, as they turn a bullet's.",
          "type": "object",
          "properties": {
            "active_ticks": {
              "description": "1 to `MAX_ZONE_TICKS`.",
              "$ref": "#/$defs/Expr"
            },
            "anchor": {
              "$ref": "#/$defs/Anchor"
            },
            "direction": {
              "$ref": "#/$defs/Direction",
              "default": {
                "offset": 0,
                "type": "aimed"
              }
            },
            "offset": {
              "$ref": "#/$defs/Offset",
              "default": {
                "forward": 0,
                "right": 0
              }
            },
            "shape": {
              "$ref": "#/$defs/ZoneShape"
            },
            "type": {
              "type": "string",
              "const": "zone"
            },
            "wind_up_ticks": {
              "description": "0 to `MAX_ZONE_TICKS`; 0 is a zone that hurts at once.",
              "$ref": "#/$defs/Expr"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "shape",
            "wind_up_ticks",
            "active_ticks"
          ]
        }
      ]
    },
    "Expr": {
      "description": "A fixed-point expression (ADR-036): a literal, an input, or an operator. No variables,\nloops or recursion beyond the tree itself.",
      "anyOf": [
        {
          "description": "The attack's argument at this index.",
          "type": "object",
          "properties": {
            "arg": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "arg"
          ]
        },
        {
          "description": "Index of the innermost `repeat`, `ring` or `spread`.",
          "type": "string",
          "const": "loop_index"
        },
        {
          "description": "Ticks since the attack started: 0 on its first tick.",
          "type": "string",
          "const": "phase_time"
        },
        {
          "description": "A draw from the run's SplitMix64 (ADR-033), from `lo` to `hi` inclusive; `lo` if the\nrange is empty. Expressions are evaluated left to right, so the order of draws is fixed.",
          "type": "object",
          "properties": {
            "rand": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "rand"
          ]
        },
        {
          "type": "object",
          "properties": {
            "add": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "add"
          ]
        },
        {
          "type": "object",
          "properties": {
            "sub": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "sub"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mul": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "mul"
          ]
        },
        {
          "type": "object",
          "properties": {
            "div": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "div"
          ]
        },
        {
          "type": "object",
          "properties": {
            "min": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "min"
          ]
        },
        {
          "type": "object",
          "properties": {
            "max": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "max"
          ]
        },
        {
          "description": "`[value, lo, hi]`.",
          "type": "object",
          "properties": {
            "clamp": {
              "type": "array",
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                },
                {
                  "$ref": "#/$defs/Expr"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "clamp"
          ]
        },
        {
          "description": "A literal; written as a plain integer.",
          "type": "integer",
          "format": "int32"
        }
      ]
    },
    "Fx": {
      "description": "A length in 1/256 pixel units. In files it is the plain integer.",
      "type": "integer",
      "format": "int32"
    },
    "HitBox": {
      "description": "A hit box, in the attacker's own frame: `offset` is forward along the attacker's facing\nand to its right, from the `anchor`.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "anchor": {
              "$ref": "#/$defs/Anchor"
            },
            "offset": {
              "$ref": "#/$defs/Offset",
              "default": {
                "forward": 0,
                "right": 0
              }
            },
            "radius": {
              "$ref": "#/$defs/Fx"
            },
            "type": {
              "type": "string",
              "const": "circle"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "radius"
          ]
        },
        {
          "description": "A circle sector centred on the facing, `half_angle` to each side.",
          "type": "object",
          "properties": {
            "anchor": {
              "$ref": "#/$defs/Anchor"
            },
            "half_angle": {
              "type": "integer",
              "format": "int32"
            },
            "offset": {
              "$ref": "#/$defs/Offset",
              "default": {
                "forward": 0,
                "right": 0
              }
            },
            "radius": {
              "$ref": "#/$defs/Fx"
            },
            "type": {
              "type": "string",
              "const": "arc"
