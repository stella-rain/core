{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Snapshot",
  "type": "object",
  "properties": {
    "bullets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BulletView"
      }
    },
    "entities": {
      "description": "Companions, enemies, the boss and its parts, in entity-ID order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/EntityView"
      }
    },
    "map": {
      "description": "The map's size, so the frontend can bound its camera (core#87).",
      "$ref": "#/$defs/MapView"
    },
    "player": {
      "$ref": "#/$defs/PlayerView"
    },
    "progress": {
      "description": "Experience, level, stat points and the open offer; absent in a stage without levels.",
      "anyOf": [
        {
          "$ref": "#/$defs/ProgressView"
        },
        {
          "type": "null"
        }
      ]
    },
    "stars": {
      "description": "Falling stars on the map, in the order they dropped (ADR-066 §2).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/StarView"
      }
    },
    "tick": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "tick",
    "map",
    "player",
    "entities",
    "bullets"
  ],
  "$defs": {
    "AttackView": {
      "description": "An attack in progress (ADR-055), for the frontend to draw its telegraph and its swing on the\nsame tick that `core` judges them.",
      "type": "object",
      "properties": {
        "facing": {
          "description": "The facing locked when the attack started.",
          "$ref": "#/$defs/Facing"
        },
        "hit_box": {
          "anyOf": [
            {
              "$ref": "#/$defs/HitBox"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/PhaseKind"
        },
        "phase": {
          "description": "Which phase, from 0.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "preset": {
          "description": "The preset it came from; absent for an inline attack.",
          "anyOf": [
            {
              "$ref": "#/$defs/ContentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "slot": {
          "description": "0 for an agent's or the boss's attacks and the main character's Main weapon; 1 for its\nSub weapon, 2 for its charged skill and 3 for its Sub skill (core#83).",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "tick": {
          "description": "Ticks done in the phase: 0 on its first tick.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "ticks": {
          "description": "How long the phase lasts.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "slot",
        "phase",
        "kind",
        "tick",
        "ticks",
        "facing"
      ]
    },
    "BulletView": {
      "description": "Bullets carry no ID or asset name: thousands are drawn per tick, batched by `style`.",
      "type": "object",
      "properties": {
        "at": {
          "$ref": "#/$defs/Point"
        },
        "friendly": {
          "description": "Fired by the main character or a companion, rather than an enemy.",
          "type": "boolean"
        },
        "radius": {
          "$ref": "#/$defs/Fx"
        },
        "style": {
          "description": "The bullet asset, as an index into the bullet asset IDs the stage uses, in order of\nfirst appearance.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "vx": {
          "description": "How far the bullet moves each tick, in 1/256 pixel: it moved by this to reach `at`, and\nmoves by it again on the next tick. The frontend draws it at `at` plus this times the\nfraction of the tick that has passed.",
          "$ref": "#/$defs/Fx"
        },
        "vy": {
          "$ref": "#/$defs/Fx"
        }
      },
      "additionalProperties": false,
      "required": [
        "at",
        "vx",
        "vy",
        "radius",
        "style",
        "friendly"
      ]
    },
    "CandidateView": {
      "description": "A reward an offer holds.",
      "type": "object",
      "properties": {
        "rarity": {
          "$ref": "#/$defs/Rarity"
        },
        "reward": {
          "description": "Its ID in the run's rewards file.",
          "$ref": "#/$defs/ContentId"
        }
      },
      "additionalProperties": false,
      "required": [
        "reward",
        "rarity"
      ]
    },
    "ChargeView": {
      "description": "A charge in progress (ADR-050). `core` judges the perfect window on this tick, so what the\nfrontend shows is what a release on the next tick gets.",
      "type": "object",
      "properties": {
        "held": {
          "description": "Ticks held since the press, 0 on the press's tick.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "level": {
          "description": "The level reached, from 1.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "perfect": {
          "description": "Inside the level's perfect window: letting go on the next tick is a perfect release.",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "level",
        "held",
        "perfect"
      ]
    },
    "ContentId": {
      "description": "A content ID from the registry (ADR-026): asset, palette, part, preset, status or pattern.\nLowercase `snake_case`, at most 32 characters; the validator checks the format and that the\nID exists.",
      "type": "string"
    },
    "EntityId": {
      "description": "An entity in a run, numbered in spawn order. Agents are evaluated in this order (ADR-036).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "EntityKind": {
      "type": "string",
      "enum": [
        "companion",
        "enemy",
        "boss",
        "boss_part"
      ]
    },
    "EntityView": {
      "type": "object",
      "properties": {
        "asset": {
          "$ref": "#/$defs/ContentId"
        },
        "at": {
          "$ref": "#/$defs/Point"
        },
        "attack": {
          "description": "The attack it is making, if any.",
          "anyOf": [
            {
              "$ref": "#/$defs/AttackView"
            },
            {
              "type": "null"
            }
          ]
        },
        "hp": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "id": {
          "$ref": "#/$defs/EntityId"
        },
        "kind": {
          "$ref": "#/$defs/EntityKind"
        },
        "palette": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "radius": {
          "description": "The hurt circle that hits use.",
          "$ref": "#/$defs/Fx"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "asset",
        "at",
        "radius",
        "hp"
      ]
    },
    "EvadeView": {
      "description": "Skill 1 (ADR-050).",
      "type": "object",
      "properties": {
        "cooldown_left": {
          "description": "Ticks until it is ready again, counted from the press.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "dash_left": {
          "description": "Ticks of the dash still to move: 0 when not dashing.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "ready": {
          "description": "A press on the next tick would dash.",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "ready",
        "cooldown_left",
        "dash_left"
      ]
    },
    "Facing": {
      "description": "A direction as a unit vector times `trig::SCALE`; `y` grows down the screen.",
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "format": "int32"
        },
        "y": {
          "type": "integer",
          "format": "int32"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ]
    },
    "Fx": {
      "description": "A length in 1/256 pixel units. In files it is the plain integer.",
      "type": "integer",
      "format": "int32"
    },
    "HitBox": {
      "description": "A hit box, in the attacker's own frame: `offset` is forward along the attacker's facing\nand to its right.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "offset": {
              "$ref": "#/$defs/Offset",
              "default": {
                "forward": 0,
                "right": 0
              }
            },
            "radius": {
              "$ref": "#/$defs/Fx"
            },
            "type": {
              "type": "string",
              "const": "circle"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "radius"
          ]
        },
        {
          "description": "A circle sector centred on the facing, `half_angle` to each side.",
          "type": "object",
          "properties": {
            "half_angle": {
              "type": "integer",
              "format": "int32"
            },
            "offset": {
              "$ref": "#/$defs/Offset",
              "default": {
                "forward": 0,
                "right": 0
              }
            },
            "radius": {
              "$ref": "#/$defs/Fx"
            },
            "type": {
              "type": "string",
              "const": "arc"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "radius",
            "half_angle"
          ]
        }
      ]
    },
    "MapView": {
      "description": "The map's width and height, from its top-left corner.",
      "type": "object",
      "properties": {
        "height": {
          "$ref": "#/$defs/Fx"
        },
        "width": {
          "$ref": "#/$defs/Fx"
        }
      },
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ]
    },
    "OfferKind": {
      "description": "What opened an offer (ADR-066 §2).",
      "oneOf": [
        {
          "description": "A falling star the main character took; it can be skipped.",
          "type": "string",
          "const": "star"
        },
        {
          "description": "A boss kill: at the highest rarity of the player's tier, with no skip.",
          "type": "string",
          "const": "boss"
        }
      ]
    },
    "OfferOption": {
      "description": "One option of an open offer; `candidate` is a place in its candidates, from 0.",
      "oneOf": [
        {
          "description": "Takes the candidate's reward and closes the offer.",
          "type": "object",
          "properties": {
            "candidate": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "take"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "candidate"
          ]
        },
        {
          "description": "Draws that candidate again, spending a reroll; the offer stays open.",
          "type": "object",
          "properties": {
            "candidate": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "reroll"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "candidate"
          ]
        },
        {
          "description": "Closes the offer, taking nothing.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "skip"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "description": "Takes the candidate's reward out of the run's pool for good, spending a banish, and\ndraws its place again; the offer stays open, or closes when nothing is left to offer.",
          "type": "object",
          "properties": {
            "candidate": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "banish"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "candidate"
          ]
        }
      ]
    },
    "OfferView": {
      "description": "An offer from a falling star (ADR-066 §3).",
      "type": "object",
      "properties": {
        "banishes_left": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CandidateView"
          }
        },
        "kind": {
          "$ref": "#/$defs/OfferKind"
        },
        "options": {
          "description": "What `Engine::choose` takes, by index: the candidates, then a reroll of each while\nrerolls are left and another reward could come, then the skip (not in a boss offer),\nthen a banish of each while banishes are left.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/OfferOption"
          }
        },
        "rarity": {
          "description": "The star's rarity, or for a boss offer the highest of the player's tier. A candidate is\nof a lower one when the pool has too few left of it.",
          "$ref": "#/$defs/Rarity"
        },
        "rerolls_left": {
          "description": "Rerolls and banishes left in the run.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "rarity",
        "candidates",
        "options",
        "rerolls_left",
        "banishes_left"
      ]
    },
    "Offset": {
      "type": "object",
      "properties": {
        "forward": {
          "$ref": "#/$defs/Fx",
          "default": 0
        },
        "right": {
          "$ref": "#/$defs/Fx",
          "default": 0
        }
      },
      "additionalProperties": false
    },
    "PhaseKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "recovery"
          ]
        },
        {
          "description": "The telegraph: its hit box is the warned area, and it deals no damage.",
          "type": "string",
          "const": "wind_up"
        },
        {
          "description": "Its hit box deals damage.",
          "type": "string",
          "const": "active"
        }
      ]
    },
    "PlayerView": {
      "type": "object",
      "properties": {
        "at": {
          "$ref": "#/$defs/Point"
        },
        "attacks": {
          "description": "Its attacks in progress, by slot.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AttackView"
          }
        },
        "charge": {
          "description": "The charge in progress (skill 2), if any (ADR-050).",
          "anyOf": [
            {
              "$ref": "#/$defs/ChargeView"
            },
            {
              "type": "null"
            }
          ]
        },
        "evade": {
          "$ref": "#/$defs/EvadeView"
        },
        "facing": {
          "description": "The last non-zero movement direction (ADR-055).",
          "$ref": "#/$defs/Facing"
        },
        "hp": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "invulnerable": {
          "description": "Ticks of invulnerability left, after a hit or from an evade; the frontend can flash it.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "main_skill": {
          "description": "Skill 2, the charged Main skill.",
          "$ref": "#/$defs/SkillView"
        },
        "radius": {
          "description": "The main character's hurt circle.",
          "$ref": "#/$defs/Fx"
        },
        "sub_skill": {
          "description": "Skill 3, the Sub skill.",
          "$ref": "#/$defs/SkillView"
        }
      },
      "additionalProperties": false,
      "required": [
        "at",
        "hp",
        "radius",
        "facing",
        "invulnerable",
        "evade",
        "main_skill",
        "sub_skill"
      ]
    },
    "Point": {
      "description": "A point on the playfield, from its top-left corner.",
      "type": "object",
      "properties": {
        "x": {
          "$ref": "#/$defs/Fx"
        },
        "y": {
          "$ref": "#/$defs/Fx"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ]
    },
    "ProgressView": {
      "description": "Where the run stands in experience, levels and stat points (ADR-066 §2, §4).",
      "type": "object",
      "properties": {
        "level": {
          "description": "From 1.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "offer": {
          "description": "The open offer: while it is open the world is stopped, and `Engine::choose` takes one\nof its options (ADR-066 §3).",
          "anyOf": [
            {
              "$ref": "#/$defs/OfferView"
            },
            {
              "type": "null"
            }
          ]
        },
        "points": {
          "description": "Stat points not spent yet.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "spent": {
          "description": "Points spent on each run stat, in the run stats' order (ADR-067).",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0
          }
        },
        "xp": {
          "description": "Experience gained toward the next level.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "xp_next": {
          "description": "Experience the next level needs; 0 at the highest level.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "level",
        "xp",
        "xp_next",
        "points",
        "spent"
      ]
    },
    "Rarity": {
      "description": "A reward's rarity, from the most common up (ADR-066 §2).",
      "type": "string",
      "enum": [
        "common",
        "uncommon",
        "rare",
        "epic",
        "legendary",
        "supernova"
      ]
    },
    "SkillView": {
      "description": "Skill 2 or 3 (ADR-050).",
      "type": "object",
      "properties": {
        "cooldown_left": {
          "description": "Ticks until it is ready again.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "ready": {
          "description": "A press on the next tick would start it (the Sub skill only if it finds a target).",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "ready",
        "cooldown_left"
      ]
    },
    "StarView": {
      "description": "A falling star waiting on the map to be taken.",
      "type": "object",
      "properties": {
        "at": {
          "$ref": "#/$defs/Point"
        },
        "id": {
          "$ref": "#/$defs/EntityId"
        },
        "rarity": {
          "$ref": "#/$defs/Rarity"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "at",
        "rarity"
      ]
    }
  }
}
