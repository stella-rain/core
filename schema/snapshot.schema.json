{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Snapshot",
  "type": "object",
  "properties": {
    "bullets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BulletView"
      }
    },
    "entities": {
      "description": "Companions, enemies, the boss and its parts, in entity-ID order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/EntityView"
      }
    },
    "expertise": {
      "description": "The expertise gauge (ADR-078); absent in a stage whose enemies and boss give no\nexpertise points.",
      "anyOf": [
        {
          "$ref": "#/$defs/ExpertiseView"
        },
        {
          "type": "null"
        }
      ]
    },
    "map": {
      "description": "The map's size, so the frontend can bound its camera (core#87).",
      "$ref": "#/$defs/MapView"
    },
    "player": {
      "$ref": "#/$defs/PlayerView"
    },
    "progress": {
      "description": "Experience, level, stat points and the open offer; absent in a stage without levels.",
      "anyOf": [
        {
          "$ref": "#/$defs/ProgressView"
        },
        {
          "type": "null"
        }
      ]
    },
    "stars": {
      "description": "Falling stars on the map, in the order they dropped (ADR-079 §2).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/StarView"
      }
    },
    "tick": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "tick",
    "map",
    "player",
    "entities",
    "bullets"
  ],
  "$defs": {
    "AttackView": {
      "description": "An attack in progress (ADR-055), for the frontend to draw its telegraph and its swing on the\nsame tick that `core` judges them.",
      "type": "object",
      "properties": {
        "facing": {
          "description": "The facing locked when the attack started; an orbit's orb's turns every tick, and its hit\nbox with it.",
          "$ref": "#/$defs/Facing"
        },
        "hit_box": {
          "anyOf": [
            {
              "$ref": "#/$defs/HitBox"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/PhaseKind"
        },
        "phase": {
          "description": "Which phase, from 0.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "preset": {
          "description": "The preset it came from; absent for an inline attack.",
          "anyOf": [
            {
              "$ref": "#/$defs/ContentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "slot": {
          "description": "0 for an agent's or the boss's attacks and the main character's combo (ADR-069).",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "tick": {
          "description": "Ticks done in the phase: 0 on its first tick.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "ticks": {
          "description": "How long the phase lasts.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "slot",
        "phase",
        "kind",
        "tick",
        "ticks",
        "facing"
      ]
    },
    "BulletView": {
      "description": "Bullets carry no ID or asset name: thousands are drawn per tick, batched by `style`.",
      "type": "object",
      "properties": {
        "at": {
          "$ref": "#/$defs/Point"
        },
        "friendly": {
          "description": "Fired by the main character or a companion, rather than an enemy.",
          "type": "boolean"
        },
        "radius": {
          "$ref": "#/$defs/Fx"
        },
        "style": {
          "description": "The bullet asset, as an index into the bullet asset IDs the stage uses, in order of\nfirst appearance.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "vx": {
          "description": "How far the bullet moves each tick, in 1/256 pixel: it moved by this to reach `at`, and\nmoves by it again on the next tick. The frontend draws it at `at` plus this times the\nfraction of the tick that has passed.",
          "$ref": "#/$defs/Fx"
        },
        "vy": {
          "$ref": "#/$defs/Fx"
        }
      },
      "additionalProperties": false,
      "required": [
        "at",
        "vx",
        "vy",
        "radius",
        "style",
        "friendly"
      ]
    },
    "CandidateView": {
      "description": "A reward an offer holds.",
      "type": "object",
      "properties": {
        "rarity": {
          "$ref": "#/$defs/Rarity"
        },
        "reward": {
          "description": "Its ID in the run's rewards file.",
          "$ref": "#/$defs/ContentId"
        }
      },
      "additionalProperties": false,
      "required": [
        "reward",
        "rarity"
      ]
    },
    "ChargeView": {
      "description": "A charge in progress (ADR-070). `core` judges the perfect window on this tick, so what the\nfrontend shows is what a release on the next tick gets.",
      "type": "object",
      "properties": {
        "held": {
          "description": "Ticks held since the step began to charge, 0 on its first tick.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "level": {
          "description": "The level reached: 0 before level 1, when letting go is a plain step and the frontend\nkeeps its clock at full speed (ADR-071).",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "perfect": {
          "description": "Inside the level's perfect window: letting go on the next tick is a perfect release.",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "level",
        "held",
        "perfect"
      ]
    },
    "ComboView": {
      "description": "Where the main character is in its combos (ADR-070): what the frontend's combo trail draws,\nwith the next possible presses read from the weapon's tree.",
      "type": "object",
      "properties": {
        "auto": {
          "description": "The auto combo: the presses auto mode plays from the root (ADR-073).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Press"
          }
        },
        "buffered": {
          "description": "The press waiting for the next step.",
          "anyOf": [
            {
              "$ref": "#/$defs/Press"
            },
            {
              "type": "null"
            }
          ]
        },
        "dash": {
          "description": "The presses began in the dash branch (a dash-strike).",
          "type": "boolean"
        },
        "presses": {
          "description": "The presses from the root to the current step; empty at the root.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Press"
          }
        },
        "window_left": {
          "description": "Ticks left in which a press continues the combo, once a step has run out.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "window_left"
      ]
    },
    "ContentId": {
      "description": "A content ID from the registry (ADR-026): asset, palette, part, preset, status or pattern.\nLowercase `snake_case`, at most 32 characters; the validator checks the format and that the\nID exists.",
      "type": "string"
    },
    "Enchantment": {
      "description": "An enchantment of the Main weapon's combo (ADR-070, ADR-078): one of a closed list built into\n`core`, its strength the reward's `amount`. It changes every combo step started after it is\ntaken: A and B steps, the dash-strike and charged releases alike; the stage skill and orbits\nare not combo steps.",
      "oneOf": [
        {
          "description": "Every hit box of the step is `amount` percent larger: its radius and its offset, rounded\ntoward zero; an arc's angle stays. The bullets a step spawns are not changed.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "range"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        }
      ]
    },
    "EnchantmentView": {
      "description": "An enchantment held (ADR-070, ADR-078).",
      "type": "object",
      "properties": {
        "amount": {
          "description": "Its strength: for range, how much wider, in percent.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "enchantment": {
          "$ref": "#/$defs/Enchantment"
        },
        "reward": {
          "description": "The reward that gave it, for its name.",
          "$ref": "#/$defs/ContentId"
        }
      },
      "additionalProperties": false,
      "required": [
        "reward",
        "enchantment",
        "amount"
      ]
    },
    "EntityId": {
      "description": "An entity in a run, numbered in spawn order. Agents are evaluated in this order (ADR-036).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "EntityKind": {
      "type": "string",
      "enum": [
        "companion",
        "enemy",
        "boss",
        "boss_part"
      ]
    },
    "EntityView": {
      "type": "object",
      "properties": {
        "asset": {
          "$ref": "#/$defs/ContentId"
        },
        "at": {
          "$ref": "#/$defs/Point"
        },
        "attack": {
          "description": "The attack it is making, if any.",
          "anyOf": [
            {
              "$ref": "#/$defs/AttackView"
            },
            {
              "type": "null"
            }
          ]
        },
        "elite": {
          "description": "An elite enemy (ADR-068), which the minimap shows wherever it is.",
          "type": "boolean"
        },
        "hp": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "id": {
          "$ref": "#/$defs/EntityId"
        },
        "kind": {
          "$ref": "#/$defs/EntityKind"
        },
        "palette": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "radius": {
          "description": "The hurt circle that hits use.",
          "$ref": "#/$defs/Fx"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "asset",
        "at",
        "radius",
        "hp"
      ]
    },
    "EvadeView": {
      "description": "The evade and its charges (ADR-074).",
      "type": "object",
      "properties": {
        "charges": {
          "description": "The charges held, ready or recovering: from the stage's `charges`, raised by rewards up\nto its `max_charges`.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "dash_left": {
          "description": "Ticks of the dash still to move: 0 when not dashing.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "ready": {
          "description": "The charges ready: a press on the next tick dashes when it is more than 0, even during a\ndash.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "recovering": {
          "description": "Ticks left on each spent charge, in the order they were spent; each counts from the\npress that spent it.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "charges",
        "ready",
        "dash_left"
      ]
    },
    "ExpertiseView": {
      "description": "The one expertise gauge of both weapons (ADR-078 §1 to §3): its level, from 0, and its\npoints toward the next. A level opens nothing yet.",
      "type": "object",
      "properties": {
        "level": {
          "description": "From 0, with no highest level.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "next": {
          "description": "Points the next level needs.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "points": {
          "description": "Points gained toward the next level.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "level",
        "points",
        "next"
      ]
    },
    "Facing": {
      "description": "A direction as a unit vector times `trig::SCALE`; `y` grows down the screen.",
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "format": "int32"
        },
        "y": {
          "type": "integer",
          "format": "int32"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ]
    },
    "Fx": {
      "description": "A length in 1/256 pixel units. In files it is the plain integer.",
      "type": "integer",
      "format": "int32"
    },
    "HitBox": {
      "description": "A hit box, in the attacker's own frame: `offset` is forward along the attacker's facing\nand to its right.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "offset": {
              "$ref": "#/$defs/Offset",
              "default": {
                "forward": 0,
                "right": 0
              }
            },
            "radius": {
              "$ref": "#/$defs/Fx"
            },
            "type": {
              "type": "string",
              "const": "circle"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "radius"
          ]
        },
        {
          "description": "A circle sector centred on the facing, `half_angle` to each side.",
          "type": "object",
          "properties": {
            "half_angle": {
              "type": "integer",
              "format": "int32"
            },
            "offset": {
              "$ref": "#/$defs/Offset",
              "default": {
                "forward": 0,
                "right": 0
              }
            },
            "radius": {
              "$ref": "#/$defs/Fx"
            },
            "type": {
              "type": "string",
              "const": "arc"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "radius",
            "half_angle"
          ]
        }
      ]
    },
    "MapView": {
      "description": "The map's width and height, from its top-left corner.",
      "type": "object",
      "properties": {
        "height": {
          "$ref": "#/$defs/Fx"
        },
        "width": {
          "$ref": "#/$defs/Fx"
        }
      },
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ]
    },
    "OfferKind": {
      "description": "What opened an offer (ADR-079 §2).",
      "oneOf": [
        {
          "description": "A falling star the main character took; it can be skipped.",
          "type": "string",
          "const": "star"
        },
        {
          "description": "A boss kill: at the highest rarity of the player's tier, with no skip.",
          "type": "string",
          "const": "boss"
        }
      ]
    },
    "OfferOption": {
      "description": "One option of an open offer; `candidate` is a place in its candidates, from 0.",
      "oneOf": [
        {
          "description": "Takes the candidate's reward and closes the offer.",
          "type": "object",
          "properties": {
            "candidate": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "take"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "candidate"
          ]
        },
        {
          "description": "Draws that candidate again, spending a reroll; the offer stays open.",
          "type": "object",
          "properties": {
            "candidate": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "reroll"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "candidate"
          ]
        },
        {
          "description": "Closes the offer, taking nothing.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "skip"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "description": "Takes the candidate's reward out of the run's pool for good, spending a banish, and\ndraws its place again; the offer stays open, or closes when nothing is left to offer.",
          "type": "object",
          "properties": {
            "candidate": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "banish"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "candidate"
          ]
        }
      ]
    },
    "OfferView": {
      "description": "An offer from a falling star (ADR-079 §3).",
      "type": "object",
      "properties": {
        "banishes_left": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CandidateView"
          }
        },
        "kind": {
          "$ref": "#/$defs/OfferKind"
        },
        "options": {
          "description": "What `Engine::choose` takes, by index: the candidates, then a reroll of each while\nrerolls are left and another reward could come, then the skip (not in a boss offer),\nthen a banish of each while banishes are left.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/OfferOption"
          }
        },
        "rarity": {
          "description": "The star's rarity, or for a boss offer the highest of the player's tier. A candidate is\nof a lower one when the pool has too few left of it.",
          "$ref": "#/$defs/Rarity"
        },
        "rerolls_left": {
          "description": "Rerolls and banishes left in the run.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "rarity",
        "candidates",
        "options",
        "rerolls_left",
        "banishes_left"
      ]
    },
    "Offset": {
      "type": "object",
      "properties": {
        "forward": {
          "$ref": "#/$defs/Fx",
          "default": 0
        },
        "right": {
          "$ref": "#/$defs/Fx",
          "default": 0
        }
      },
      "additionalProperties": false
    },
    "OrbitView": {
      "description": "An orbit held (ADR-069). Its orbs' attacks are in the main character's `attacks`, in slots\n`2 + 8 × its place in orbits` and on.",
      "type": "object",
      "properties": {
        "cooldown_left": {
          "description": "Ticks until the next round may start, counted from the last one's start; 0 while a\nround that outlasts it goes on.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "orbs": {
          "description": "Its orbs: those of the next round.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "reward": {
          "description": "The reward that gave it, for its name.",
          "$ref": "#/$defs/ContentId"
        }
      },
      "additionalProperties": false,
      "required": [
        "reward",
        "orbs",
        "cooldown_left"
      ]
    },
    "PhaseKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "recovery"
          ]
        },
        {
          "description": "The telegraph: its hit box is the warned area, and it deals no damage.",
          "type": "string",
          "const": "wind_up"
        },
        {
          "description": "Its hit box deals damage.",
          "type": "string",
          "const": "active"
        }
      ]
    },
    "PlayerView": {
      "type": "object",
      "properties": {
        "at": {
          "$ref": "#/$defs/Point"
        },
        "attacks": {
          "description": "Its attacks in progress, by slot: 0 the combo, 1 the stage skill, then 8 for each orbit,\none for each orb, in the order the orbits came (ADR-069).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AttackView"
          }
        },
        "charge": {
          "description": "The current step charging, if it is (ADR-070).",
          "anyOf": [
            {
              "$ref": "#/$defs/ChargeView"
            },
            {
              "type": "null"
            }
          ]
        },
        "combo": {
          "description": "Where it is in its Main weapon's combos (ADR-070).",
          "$ref": "#/$defs/ComboView"
        },
        "enchantments": {
          "description": "The enchantments rewards gave, in the order they came (ADR-070, ADR-078): what changes\nits combo steps. A range enchantment's wider hit boxes are already in `attacks`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/EnchantmentView"
          }
        },
        "evade": {
          "$ref": "#/$defs/EvadeView"
        },
        "facing": {
          "description": "The last non-zero movement direction (ADR-055).",
          "$ref": "#/$defs/Facing"
        },
        "hp": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "invulnerable": {
          "description": "Ticks of invulnerability left, after a hit or from an evade; the frontend can flash it.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "orbits": {
          "description": "The orbits rewards gave, in the order they came (ADR-069).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/OrbitView"
          }
        },
        "pull": {
          "description": "The stage skill's pull while it pulls.",
          "anyOf": [
            {
              "$ref": "#/$defs/PullView"
            },
            {
              "type": "null"
            }
          ]
        },
        "radius": {
          "description": "The main character's hurt circle.",
          "$ref": "#/$defs/Fx"
        },
        "shield": {
          "description": "The stage skill's shield while it holds.",
          "anyOf": [
            {
              "$ref": "#/$defs/ShieldView"
            },
            {
              "type": "null"
            }
          ]
        },
        "skill": {
          "description": "The stage skill in its slot, if a reward has filled it (ADR-075).",
          "anyOf": [
            {
              "$ref": "#/$defs/SkillView"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "description": "The enemy aim assist and auto mode would face, while either is on (ADR-072), so the\nfrontend can mark it.",
          "anyOf": [
            {
              "$ref": "#/$defs/EntityId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "at",
        "hp",
        "radius",
        "facing",
        "invulnerable",
        "evade",
        "combo"
      ]
    },
    "Point": {
      "description": "A point on the playfield, from its top-left corner.",
      "type": "object",
      "properties": {
        "x": {
          "$ref": "#/$defs/Fx"
        },
        "y": {
          "$ref": "#/$defs/Fx"
        }
      },
