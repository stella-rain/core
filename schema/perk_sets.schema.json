{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PerkSetsFile",
  "description": "The perk sets file.",
  "type": "object",
  "properties": {
    "perk_sets": {
      "description": "The sets, 1 to `MAX_PERK_SETS`.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/PerkSet"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "perk_sets"
  ],
  "$defs": {
    "ContentId": {
      "description": "A content ID from the registry (ADR-026): asset, palette, part, preset, status or pattern.\nLowercase `snake_case`, at most 32 characters; the validator checks the format and that the\nID exists.",
      "type": "string"
    },
    "PerkEffect": {
      "description": "What a perk does, `amount` times over. The closed list of version 0's perk effects; the\nstat kinds are the run stats' (`StatEffect`) and add to the same totals.",
      "oneOf": [
        {
          "description": "`amount` more hit points at most, from tick 0 (the run starts at the most).",
          "type": "string",
          "const": "max_hp"
        },
        {
          "description": "`amount` hit points back every second (60 ticks), never beyond the most.",
          "type": "string",
          "const": "regen"
        },
        {
          "description": "`amount` percent more damage from every attack of the main character.",
          "type": "string",
          "const": "attack_pct"
        },
        {
          "description": "`amount` percent faster attacks.",
          "type": "string",
          "const": "attack_speed_pct"
        },
        {
          "description": "An `amount` percent shorter evade cooldown.",
          "type": "string",
          "const": "evade_pct"
        },
        {
          "description": "`amount` percent more movement speed.",
          "type": "string",
          "const": "speed_pct"
        },
        {
          "description": "`amount` more rerolls for offers, on top of the stage's and the setup's.",
          "type": "string",
          "const": "extra_rerolls"
        },
        {
          "description": "`amount` more banishes for offers, on top of the stage's.",
          "type": "string",
          "const": "extra_banishes"
        }
      ]
    },
    "PerkEntry": {
      "description": "One effect of a set.",
      "type": "object",
      "properties": {
        "amount": {
          "description": "From 1 to the effect's cap (`PerkEffect::most`).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "effect": {
          "$ref": "#/$defs/PerkEffect"
        }
      },
      "additionalProperties": false,
      "required": [
        "effect",
        "amount"
      ]
    },
    "PerkSet": {
      "description": "One perk set.",
      "type": "object",
      "properties": {
        "effects": {
          "description": "Its effects, at most `MAX_PERK_EFFECTS`, each kind once.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PerkEntry"
          }
        },
        "id": {
          "description": "The set's own ID, unique within the file.",
          "$ref": "#/$defs/ContentId"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "effects"
      ]
    }
  }
}
