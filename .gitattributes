# Line endings: LF in the repository and in every working copy, whatever core.autocrlf says.
# CI (eol-check) fails if this line is removed or a file with CRLF endings is committed.
* text=auto eol=lf

# Binary files: never converted, never diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.woff2 binary
*.zip binary
*.apk binary
*.aab binary
*.jks binary
*.keystore binary
*.so binary
*.dll binary
*.bin binary

# Generated sets (`cargo xtask bless`, and the bench pins): PR diffs collapse them
# (linguist-generated) and `.github/scripts/diff_size.py` leaves them out of a PR's
# hand-written line count. `test_gitattributes.py` checks every generated file is listed here.
#
# Replay corpus (`UPDATE_CORPUS=1`): `git diff` does not print it either (-diff; the per-tick
# `hashes.bin` is binary). The corpus
# stages (`stage.json`) are written by hand and stay visible. `case.json` (the pack a case
# pins) and the pack files in `packs/` are written by the same run.
tests/corpus/**/run.replay linguist-generated=true -diff
tests/corpus/**/hashes.bin linguist-generated=true
tests/corpus/**/case.json linguist-generated=true
tests/corpus/**/packs/*.json linguist-generated=true -diff
# JSON Schema (`UPDATE_SCHEMA=1`), goldens (`INSTA_UPDATE=always`), the content pack
# (`content-pack export`) and the bench pins (`UPDATE_BENCH_PINS=1`): still diffed locally,
# since a change there is what a reviewer checks.
schema/** linguist-generated=true
tests/golden/** linguist-generated=true
content/pack.json linguist-generated=true
tests/bench_pins.toml linguist-generated=true
